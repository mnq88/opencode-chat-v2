{
  "name": "opencode-chat-v2",
  "version": "0.1.0",
  "description": "Chatifiers for OpenCode V2: conversational chat agents, persistent memory, todo tracking, and semantic code search. Successor to IgorWarzocha/Opencode-Chat.",
  "type": "module",
  "license": "MIT",
  "main": "dist/server.js",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "opencode-chat-v2": "bin/setup.mjs"
  },
  "files": [
    "dist",
    "server.js",
    "agents",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.18",
    "@types/node": "24.19.0",
    "typescript": "5.9.3"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "chat",
    "chatifier",
    "semantic-search",
    "memory"
  ],
  "engines": {
    "node": ">=22"
  }
}
